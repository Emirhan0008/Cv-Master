# ============================================================
# CV-Master — Ortam değişkenleri
# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun.
# ============================================================

# --- Yapay zeka (zorunlu: AI içe aktarma / metin optimizasyonu) ---
# Ücretsiz anahtar: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# --- Opsiyonel: kullanılacak Gemini modeli ---
# Varsayılan: gemini-3.5-flash
# GEMINI_MODEL="gemini-3.5-flash"

# --- Opsiyonel: sunucu portu (varsayılan 3000) ---
# PORT=3000

# ============================================================
# Firebase (bulut senkron + Google ile giriş) — OPSİYONEL
# Bu değerler gizli değildir (web istemcisinde herkese açıktır).
# Güvenlik Firestore kuralları ile sağlanır.
# Firebase Console > Proje Ayarları > Uygulamalar > SDK kurulumu
# ============================================================
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN="<proje>.firebaseapp.com"
# VITE_FIREBASE_PROJECT_ID="<proje>"
# VITE_FIREBASE_STORAGE_BUCKET="<proje>.firebasestorage.app"
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_APP_ID=""
